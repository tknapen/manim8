{
  "$defs": {
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "checked": {
          "enum": [
            "bibliographic",
            "abstract",
            "full_text"
          ],
          "title": "Checked",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "pattern": "^10\\.\\d{4,9}/\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "finding": {
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "citation",
        "finding",
        "checked"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "references": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "minItems": 1,
      "title": "References",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "references"
  ],
  "title": "ReferenceList",
  "type": "object"
}
