{
  "$defs": {
    "DataBinding": {
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "$ref": "#/$defs/DataEncoding"
        },
        "source": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source",
          "type": "string"
        },
        "transforms": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "filter": "#/$defs/FilterTransform",
                "normalize": "#/$defs/NormalizeTransform",
                "scale": "#/$defs/ScaleTransform",
                "smooth": "#/$defs/SmoothTransform",
                "sort": "#/$defs/SortTransform"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/FilterTransform"
              },
              {
                "$ref": "#/$defs/NormalizeTransform"
              },
              {
                "$ref": "#/$defs/SortTransform"
              },
              {
                "$ref": "#/$defs/ScaleTransform"
              },
              {
                "$ref": "#/$defs/SmoothTransform"
              }
            ]
          },
          "title": "Transforms",
          "type": "array"
        }
      },
      "required": [
        "source",
        "encoding"
      ],
      "title": "DataBinding",
      "type": "object"
    },
    "DataEncoding": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "x": {
          "minLength": 1,
          "title": "X",
          "type": "string"
        },
        "y": {
          "minLength": 1,
          "title": "Y",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "DataEncoding",
      "type": "object"
    },
    "EquationRef": {
      "additionalProperties": false,
      "properties": {
        "highlight": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Highlight",
          "type": "array"
        },
        "highlight_mode": {
          "default": "always",
          "enum": [
            "always",
            "active"
          ],
          "title": "Highlight Mode",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "EquationRef",
      "type": "object"
    },
    "FadeAxes": {
      "additionalProperties": false,
      "description": "Fade the frame, ticks and labels of a `surface_plot` out (or back in) over a window; the surface stays.\n\nShow the axes while the viewer learns the box, then let them go once the shape alone carries the meaning.\nA fade may run beside sweeps and orbits; two fades of the same object may not overlap.",
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "easing": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "ease_in_out_sine",
                "smooth",
                "ease_out_cubic",
                "eased_linear",
                "ease_in_quad",
                "ease_out_quad"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Easing"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "fade_axes",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "visible": {
          "default": false,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "id",
        "target",
        "at_seconds",
        "duration_seconds"
      ],
      "title": "FadeAxes",
      "type": "object"
    },
    "FadeObject": {
      "additionalProperties": false,
      "description": "Fade an object out (`visible: false`) or back in over a window (ADR-034). A faded object stays registered\nbut is absent from layout reports until a fade brings it back; two fades of one object may not overlap.\n`fade_axes` remains the special case for a surface's frame.",
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "easing": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "ease_in_out_sine",
                "smooth",
                "ease_out_cubic",
                "eased_linear",
                "ease_in_quad",
                "ease_out_quad"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Easing"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "fade_object",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "visible": {
          "default": false,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "id",
        "target",
        "at_seconds",
        "duration_seconds"
      ],
      "title": "FadeObject",
      "type": "object"
    },
    "FilterTransform": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "equals": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Equals"
        },
        "op": {
          "const": "filter",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "column",
        "equals"
      ],
      "title": "FilterTransform",
      "type": "object"
    },
    "MoveObject": {
      "additionalProperties": false,
      "description": "Move an object over a window (ADR-034).\n\nA flat object moves in the frame: to an `Anchor` of the safe area (`to_anchor`), or `by` an offset given as\nfractions of the safe frame's width and height. An object anchored in a surface's data coordinates (a\n`sphere`) moves `to_point`, a point in those coordinates. Exactly one of the three is given. The motion\nstarts from wherever the object is when the window opens and ends at the absolute target, so a checkpoint\ninside the window is reached by the real flow; readouts and emphasis placed relative to the object follow\nit while their own actions run. Two moves of one object may not overlap.",
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "by": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "easing": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "ease_in_out_sine",
                "smooth",
                "ease_out_cubic",
                "eased_linear",
                "ease_in_quad",
                "ease_out_quad"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Easing"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "move_object",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "to_anchor": {
          "anyOf": [
            {
              "enum": [
                "top_left",
                "top_center",
                "top_right",
                "center_left",
                "center",
                "center_right",
                "bottom_left",
                "bottom_center",
                "bottom_right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Anchor"
        },
        "to_point": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Point"
        }
      },
      "required": [
        "kind",
        "id",
        "target",
        "at_seconds",
        "duration_seconds"
      ],
      "title": "MoveObject",
      "type": "object"
    },
    "Narration": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Narration",
      "type": "object"
    },
    "NormalizeTransform": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "default": "max",
          "enum": [
            "max",
            "sum",
            "first"
          ],
          "title": "By",
          "type": "string"
        },
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "op": {
          "const": "normalize",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "column"
      ],
      "title": "NormalizeTransform",
      "type": "object"
    },
    "OrbitCamera": {
      "additionalProperties": false,
      "description": "Turn the camera around the scene's surface over a window: the azimuth (`theta`) and the elevation (`phi`)\nmove from where they are to the given angles with the easing. Flat objects stay fixed in the frame; only\n`surface_plot` objects turn, so a scene needs one. Orbits may run alongside parameter sweeps.",
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "easing": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "ease_in_out_sine",
                "smooth",
                "ease_out_cubic",
                "eased_linear",
                "ease_in_quad",
                "ease_out_quad"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Easing"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "orbit_camera",
          "title": "Kind",
          "type": "string"
        },
        "to_phi_degrees": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Phi Degrees"
        },
        "to_theta_degrees": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Theta Degrees"
        }
      },
      "required": [
        "kind",
        "id",
        "at_seconds",
        "duration_seconds"
      ],
      "title": "OrbitCamera",
      "type": "object"
    },
    "ParameterRef": {
      "additionalProperties": false,
      "description": "A transform setting that a `vary_parameter` action can sweep: `{parameter: w, default: 5}` names the\nparameter and the value it has until an action moves it (ADR-034).",
      "properties": {
        "default": {
          "title": "Default",
          "type": "number"
        },
        "parameter": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Parameter",
          "type": "string"
        }
      },
      "required": [
        "parameter",
        "default"
      ],
      "title": "ParameterRef",
      "type": "object"
    },
    "ScaleTransform": {
      "additionalProperties": false,
      "description": "Multiply a numeric column by a factor; a parameterised factor makes the plot sweepable.",
      "properties": {
        "by": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/ParameterRef"
            }
          ],
          "title": "By"
        },
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "op": {
          "const": "scale",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "column",
        "by"
      ],
      "title": "ScaleTransform",
      "type": "object"
    },
    "Scene": {
