            "oneOf": [
              {
                "$ref": "#/$defs/VaryParameter"
              },
              {
                "$ref": "#/$defs/OrbitCamera"
              },
              {
                "$ref": "#/$defs/FadeAxes"
              },
              {
                "$ref": "#/$defs/MoveObject"
              },
              {
                "$ref": "#/$defs/FadeObject"
              },
              {
                "$ref": "#/$defs/TransformEquation"
              }
            ]
          },
          "title": "Actions",
          "type": "array"
        },
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "narration": {
          "anyOf": [
