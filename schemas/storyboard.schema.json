    "TransformEquation": {
      "additionalProperties": false,
      "description": "Turn the equation an `equation_block` or `equation_label` shows into another declared equation (ADR-034).\n\nThe target equation is typeset with the same highlighted symbols; occurrences of a highlighted symbol pair\nby name (`by_symbol`, the default: the first occurrence in the old equation goes to the first in the new,\nand so on) and every other glyph pairs by shape, so an `=` or a `2` glides to its new place; glyphs without\na partner fade out or in. Named symbols are the only parts matched by meaning; everything else is matched\nby shape, which can pair glyphs that merely look alike. Once the window closes the object shows the new\nequation, and later `vary_parameter` emphasis on it resolves symbols against that equation. A block that\nlists symbol definitions cannot be transformed; two transforms of one object may not overlap, and a sweep\nthat emphasizes the object may not start inside the window (its pulse would play on glyphs being replaced).",
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "easing": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "ease_in_out_sine",
                "smooth",
                "ease_out_cubic",
                "eased_linear",
                "ease_in_quad",
                "ease_out_quad"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Easing"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "transform_equation",
          "title": "Kind",
          "type": "string"
        },
        "match": {
          "default": "by_symbol",
          "enum": [
            "by_symbol",
            "by_shape"
          ],
          "title": "Match",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "to": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "kind",
