    "MoveObject": {
      "additionalProperties": false,
      "description": "Move an object over a window (ADR-034).\n\nA flat object moves in the frame: to an `Anchor` of the safe area (`to_anchor`), or `by` an offset given as\nfractions of the safe frame's width and height. An object anchored in a surface's data coordinates (a\n`sphere`) moves `to_point`, a point in those coordinates. Exactly one of the three is given. The motion\nstarts from wherever the object is when the window opens and ends at the absolute target, so a checkpoint\ninside the window is reached by the real flow; readouts and emphasis placed relative to the object follow\nit while their own actions run. Two moves of one object may not overlap.",
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "by": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "easing": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "ease_in_out_sine",
                "smooth",
                "ease_out_cubic",
                "eased_linear",
                "ease_in_quad",
                "ease_out_quad"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Easing"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "move_object",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "to_anchor": {
          "anyOf": [
            {
              "enum": [
                "top_left",
                "top_center",
                "top_right",
                "center_left",
                "center",
                "center_right",
                "bottom_left",
                "bottom_center",
                "bottom_right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Anchor"
        },
        "to_point": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Point"
        }
      },
      "required": [
        "kind",
        "id",
        "target",
        "at_seconds",
        "duration_seconds"
      ],
      "title": "MoveObject",
      "type": "object"
    },
