      "title": "EquationRef",
      "type": "object"
    },
    "FadeAxes": {
      "additionalProperties": false,
      "description": "Fade the frame, ticks and labels of a `surface_plot` out (or back in) over a window; the surface stays.\n\nShow the axes while the viewer learns the box, then let them go once the shape alone carries the meaning.\nA fade may run beside sweeps and orbits; two fades of the same object may not overlap.",
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "easing": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "ease_in_out_sine",
                "smooth",
                "ease_out_cubic",
                "eased_linear",
                "ease_in_quad",
                "ease_out_quad"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Easing"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "fade_axes",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "visible": {
          "default": false,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "id",
        "target",
        "at_seconds",
        "duration_seconds"
      ],
      "title": "FadeAxes",
      "type": "object"
    },
    "FadeObject": {
      "additionalProperties": false,
      "description": "Fade an object out (`visible: false`, the default), back in (`visible: true`), or to a level of its full\nink (`ink`, ADR-041) over a window (ADR-034).\n\n`ink: 0.3` dims the object to three tenths of its ink, so the context stays readable without competing with\nthe subject; a later fade with `visible: true` or `ink: 1` restores it. Every fade starts from the ink the\nobject has, so a dimmed object fades out from its dimmed level. A faded-out object stays registered but is\nabsent from layout reports until a fade brings it back; a dimmed one stays in them. Two fades of one object\nmay not overlap, and an object is not redrawn (swept, emphasized by a sweep, transformed or pulsed) while it\nis dimmed or a fade to or from a partial level runs, since its redrawn parts would show at full ink.\n`fade_axes` remains the special case for a surface's frame.",
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "easing": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "ease_in_out_sine",
                "smooth",
                "ease_out_cubic",
                "eased_linear",
                "ease_in_quad",
                "ease_out_quad"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Easing"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "ink": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ink"
        },
        "kind": {
          "const": "fade_object",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visible"
        }
      },
      "required": [
        "kind",
        "id",
        "target",
        "at_seconds",
        "duration_seconds"
      ],
      "title": "FadeObject",
      "type": "object"
    },
