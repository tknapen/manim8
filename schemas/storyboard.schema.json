{
  "$defs": {
    "DataBinding": {
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "$ref": "#/$defs/DataEncoding"
        },
        "source": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source",
          "type": "string"
        },
        "transforms": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "filter": "#/$defs/FilterTransform",
                "normalize": "#/$defs/NormalizeTransform",
                "sort": "#/$defs/SortTransform"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/FilterTransform"
              },
              {
                "$ref": "#/$defs/NormalizeTransform"
              },
              {
                "$ref": "#/$defs/SortTransform"
              }
            ]
          },
          "title": "Transforms",
          "type": "array"
        }
      },
      "required": [
        "source",
        "encoding"
      ],
      "title": "DataBinding",
      "type": "object"
    },
    "DataEncoding": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "x": {
          "minLength": 1,
          "title": "X",
          "type": "string"
        },
        "y": {
          "minLength": 1,
          "title": "Y",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "DataEncoding",
      "type": "object"
    },
    "EquationRef": {
      "additionalProperties": false,
      "properties": {
        "highlight": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Highlight",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "EquationRef",
      "type": "object"
    },
    "FilterTransform": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "equals": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Equals"
        },
        "op": {
          "const": "filter",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "column",
        "equals"
      ],
      "title": "FilterTransform",
      "type": "object"
    },
    "Narration": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Narration",
      "type": "object"
    },
    "NormalizeTransform": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "default": "max",
          "enum": [
            "max",
            "sum",
            "first"
          ],
          "title": "By",
          "type": "string"
        },
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "op": {
          "const": "normalize",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "column"
      ],
      "title": "NormalizeTransform",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "narration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Narration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "objects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SceneObject"
          },
          "title": "Objects",
          "type": "array"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "snapshots": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Snapshot"
          },
          "title": "Snapshots",
          "type": "array"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "id",
        "start_seconds",
        "end_seconds",
        "purpose"
      ],
      "title": "Scene",
      "type": "object"
    },
    "SceneObject": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "equation": {
          "anyOf": [
            {
              "$ref": "#/$defs/EquationRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text_caption",
            "scientific_plot",
            "function_plot",
            "equation_block",
            "equation_label",
            "comparison_plot",
            "caption_with_citation",
            "schematic_population",
            "receptive_field_glyph",
            "network_graph",
            "custom"
          ],
          "title": "Kind",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "default": {},
          "title": "Params",
          "type": "object"
        },
        "reveal_at_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reveal At Seconds"
        },
        "style_role": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style Role"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "SceneObject",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "manim_checkpoint",
          "enum": [
            "manim_checkpoint",
            "sampled_video_frame"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "at_seconds",
        "description"
      ],
      "title": "Snapshot",
      "type": "object"
    },
    "SortTransform": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "descending": {
          "default": false,
          "title": "Descending",
          "type": "boolean"
        },
        "op": {
          "const": "sort",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "column"
      ],
      "title": "SortTransform",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "based_on_animation_revision": {
      "minLength": 1,
      "title": "Based On Animation Revision",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "based_on_animation_revision",
    "scenes"
  ],
  "title": "Storyboard",
  "type": "object"
}
