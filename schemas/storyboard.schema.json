    "SmoothTransform": {
      "additionalProperties": false,
      "description": "Gaussian smoothing of a numeric column along the row order, with the standard deviation `window` in\nrows; zero leaves the column as it is. Sort and filter first so the rows that are averaged belong together.",
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "op": {
          "const": "smooth",
          "title": "Op",
          "type": "string"
