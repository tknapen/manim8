    "OrbitCamera": {
      "additionalProperties": false,
      "description": "Turn the camera around the scene's surface over a window: the azimuth (`theta`) and the elevation (`phi`)\nmove from where they are to the given angles with the easing. Flat objects stay fixed in the frame; only\n`surface_plot` objects turn, so a scene needs one. Orbits may run alongside parameter sweeps.",
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "easing": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "ease_in_out_sine",
                "smooth",
                "ease_out_cubic",
                "eased_linear",
                "ease_in_quad",
                "ease_out_quad"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Easing"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "orbit_camera",
          "title": "Kind",
          "type": "string"
        },
        "to_phi_degrees": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Phi Degrees"
        },
        "to_theta_degrees": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Theta Degrees"
        }
      },
      "required": [
        "kind",
        "id",
        "at_seconds",
        "duration_seconds"
      ],
      "title": "OrbitCamera",
      "type": "object"
    },
