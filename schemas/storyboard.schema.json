{
  "$defs": {
    "DataBinding": {
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "$ref": "#/$defs/DataEncoding"
        },
        "source": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source",
          "type": "string"
        },
        "transforms": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "filter": "#/$defs/FilterTransform",
                "normalize": "#/$defs/NormalizeTransform",
                "sort": "#/$defs/SortTransform"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/FilterTransform"
              },
              {
                "$ref": "#/$defs/NormalizeTransform"
              },
              {
                "$ref": "#/$defs/SortTransform"
              }
            ]
          },
          "title": "Transforms",
          "type": "array"
        }
      },
      "required": [
        "source",
        "encoding"
      ],
      "title": "DataBinding",
      "type": "object"
    },
    "DataEncoding": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "x": {
          "minLength": 1,
          "title": "X",
          "type": "string"
        },
        "y": {
          "minLength": 1,
          "title": "Y",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "DataEncoding",
      "type": "object"
    },
    "EquationRef": {
      "additionalProperties": false,
      "properties": {
        "highlight": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Highlight",
          "type": "array"
        },
        "highlight_mode": {
          "default": "always",
          "enum": [
            "always",
            "active"
          ],
          "title": "Highlight Mode",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "EquationRef",
      "type": "object"
    },
    "FadeAxes": {
      "additionalProperties": false,
      "description": "Fade the frame, ticks and labels of a `surface_plot` out (or back in) over a window; the surface stays.\n\nShow the axes while the viewer learns the box, then let them go once the shape alone carries the meaning.\nA fade may run beside sweeps and orbits; two fades of the same object may not overlap.",
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "easing": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "ease_in_out_sine",
                "smooth",
                "ease_out_cubic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Easing"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "fade_axes",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "visible": {
          "default": false,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "id",
        "target",
        "at_seconds",
        "duration_seconds"
      ],
      "title": "FadeAxes",
      "type": "object"
    },
    "FilterTransform": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "equals": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Equals"
        },
        "op": {
          "const": "filter",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "column",
        "equals"
      ],
      "title": "FilterTransform",
      "type": "object"
    },
    "Narration": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Narration",
      "type": "object"
    },
    "NormalizeTransform": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "default": "max",
          "enum": [
            "max",
            "sum",
            "first"
          ],
          "title": "By",
          "type": "string"
        },
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "op": {
          "const": "normalize",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "column"
      ],
      "title": "NormalizeTransform",
      "type": "object"
    },
    "OrbitCamera": {
      "additionalProperties": false,
      "description": "Turn the camera around the scene's surface over a window: the azimuth (`theta`) and the elevation (`phi`)\nmove from where they are to the given angles with the easing. Flat objects stay fixed in the frame; only\n`surface_plot` objects turn, so a scene needs one. Orbits may run alongside parameter sweeps.",
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "easing": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "ease_in_out_sine",
                "smooth",
                "ease_out_cubic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Easing"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "orbit_camera",
          "title": "Kind",
          "type": "string"
        },
        "to_phi_degrees": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Phi Degrees"
        },
        "to_theta_degrees": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Theta Degrees"
        }
      },
      "required": [
        "kind",
        "id",
        "at_seconds",
        "duration_seconds"
      ],
      "title": "OrbitCamera",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "fade_axes": "#/$defs/FadeAxes",
                "orbit_camera": "#/$defs/OrbitCamera",
                "vary_parameter": "#/$defs/VaryParameter"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/VaryParameter"
              },
              {
                "$ref": "#/$defs/OrbitCamera"
              },
              {
                "$ref": "#/$defs/FadeAxes"
              }
            ]
          },
          "title": "Actions",
          "type": "array"
        },
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "narration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Narration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "objects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SceneObject"
          },
          "title": "Objects",
          "type": "array"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "snapshots": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Snapshot"
          },
          "title": "Snapshots",
          "type": "array"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "id",
        "start_seconds",
        "end_seconds",
        "purpose"
      ],
      "title": "Scene",
      "type": "object"
    },
    "SceneObject": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "equation": {
          "anyOf": [
            {
              "$ref": "#/$defs/EquationRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text_caption",
            "scientific_plot",
            "function_plot",
            "surface_plot",
            "function_image",
            "equation_block",
            "equation_label",
            "comparison_plot",
            "caption_with_citation",
            "schematic_population",
            "receptive_field_glyph",
            "network_graph",
            "custom"
          ],
          "title": "Kind",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "default": {},
          "title": "Params",
          "type": "object"
        },
        "reveal_at_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reveal At Seconds"
        },
        "style_role": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style Role"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "SceneObject",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "manim_checkpoint",
          "enum": [
            "manim_checkpoint",
            "sampled_video_frame"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "at_seconds",
        "description"
      ],
      "title": "Snapshot",
      "type": "object"
    },
    "SortTransform": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "descending": {
          "default": false,
          "title": "Descending",
          "type": "boolean"
        },
        "op": {
          "const": "sort",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "column"
      ],
      "title": "SortTransform",
      "type": "object"
    },
    "VaryParameter": {
      "additionalProperties": false,
      "description": "Vary one named parameter of a `function_plot`, `surface_plot` or `function_image` while the viewer watches.\n\nThe picture follows the value, the equation term named by `parameter` pulses once as the action begins,\nand a readout shows the running value. With a `lead_in_seconds`, the term lights up first and the value\nmoves only afterwards, which makes a clip of several such segments read as \"this term, then this one\". A\ncheckpoint inside the window splits the sweep at that frame, so it is still reached by the real animation\nflow. Actions run concurrently unless they drive the same parameter.",
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "easing": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "ease_in_out_sine",
                "smooth",
                "ease_out_cubic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Easing"
        },
        "emphasize": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Emphasize",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "vary_parameter",
          "title": "Kind",
          "type": "string"
        },
        "lead_in_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Lead In Seconds",
          "type": "number"
        },
        "parameter": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Parameter",
          "type": "string"
        },
        "show_value": {
          "default": true,
          "title": "Show Value",
          "type": "boolean"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "number"
        },
        "value_decimals": {
          "default": 1,
          "maximum": 6,
          "minimum": 0,
          "title": "Value Decimals",
          "type": "integer"
        },
        "value_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Label"
        }
      },
      "required": [
        "kind",
        "id",
        "target",
        "parameter",
        "to",
        "at_seconds",
        "duration_seconds"
      ],
      "title": "VaryParameter",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "based_on_animation_revision": {
      "minLength": 1,
      "title": "Based On Animation Revision",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "based_on_animation_revision",
    "scenes"
  ],
  "title": "Storyboard",
  "type": "object"
}
