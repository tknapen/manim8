          "title": "Highlight",
          "type": "array"
        },
        "highlight_mode": {
          "default": "always",
          "enum": [
            "always",
            "active"
          ],
          "title": "Highlight Mode",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
