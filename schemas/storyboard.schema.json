        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "x": {
          "minLength": 1,
          "title": "X",
          "type": "string"
        },
        "y": {
          "minLength": 1,
          "title": "Y",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "DataEncoding",
      "type": "object"
    },
    "Emphasize": {
      "additionalProperties": false,
      "description": "Point at an object, or at named symbols of the equation it shows, without changing it (ADR-041).\n\nWith `cue: box` (the default) a box in the style's emphasis ink appears around the place, holds and fades\nout. With `from_target` (and `from_symbols`) the box appears at another place first and travels to the\ntarget, so the cue itself shows what a symbol names: the sigma in the equation, then the curve it widens. With\n`cue: pulse` the named symbols grow, take the emphasis ink and settle once over the window, as a sweep's\nlead-in does, while no value moves. A box surrounds the first occurrence of each named symbol. Cues are\ndrawn in the frame, so their places are flat objects, not a surface or a sphere that turns with the camera.",
      "properties": {
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        },
        "cue": {
          "default": "box",
          "enum": [
            "box",
            "pulse"
          ],
          "title": "Cue",
          "type": "string"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "easing": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "ease_in_out_sine",
                "smooth",
                "ease_out_cubic",
                "eased_linear",
                "ease_in_quad",
                "ease_out_quad"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Easing"
        },
        "from_symbols": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "title": "From Symbols",
          "type": "array"
        },
        "from_target": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Target"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "emphasize",
          "title": "Kind",
          "type": "string"
        },
        "symbols": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "title": "Symbols",
          "type": "array"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "target",
        "at_seconds",
        "duration_seconds"
      ],
      "title": "Emphasize",
      "type": "object"
    },
    "EquationRef": {
      "additionalProperties": false,
      "properties": {
        "highlight": {
          "default": [],
