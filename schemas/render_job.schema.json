{
  "$defs": {
    "Accessibility": {
      "additionalProperties": false,
      "properties": {
        "do_not_rely_on_color_alone": {
          "default": true,
          "title": "Do Not Rely On Color Alone",
          "type": "boolean"
        },
        "minimum_contrast_body": {
          "default": 4.5,
          "exclusiveMinimum": 0,
          "title": "Minimum Contrast Body",
          "type": "number"
        },
        "warn_on_low_contrast": {
          "default": true,
          "title": "Warn On Low Contrast",
          "type": "boolean"
        }
      },
      "title": "Accessibility",
      "type": "object"
    },
    "Charts": {
      "additionalProperties": false,
      "properties": {
        "grid_visible": {
          "default": false,
          "title": "Grid Visible",
          "type": "boolean"
        },
        "legend_position": {
          "default": "upper_right",
          "enum": [
            "upper_right",
            "upper_left",
            "lower_right",
            "lower_left"
          ],
          "title": "Legend Position",
          "type": "string"
        },
        "show_units_when_provided": {
          "default": true,
          "title": "Show Units When Provided",
          "type": "boolean"
        },
        "spine_offset_px_at_1080p": {
          "default": 0.0,
          "minimum": 0,
          "title": "Spine Offset Px At 1080P",
          "type": "number"
        },
        "spines": {
          "default": [
            "left",
            "bottom"
          ],
          "items": {
            "enum": [
              "left",
              "bottom",
              "top",
              "right"
            ],
            "type": "string"
          },
          "title": "Spines",
          "type": "array"
        },
        "use_shared_scales_for_comparison": {
          "default": true,
          "title": "Use Shared Scales For Comparison",
          "type": "boolean"
        }
      },
      "title": "Charts",
      "type": "object"
    },
    "Equation": {
      "additionalProperties": false,
      "description": "A typed equation. The renderer typesets the stored string exactly.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "latex": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latex"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "symbols": {
          "additionalProperties": {
            "$ref": "#/$defs/SymbolDef"
          },
          "default": {},
          "title": "Symbols",
          "type": "object"
        },
        "typst": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Typst"
        }
      },
      "required": [
        "id"
      ],
      "title": "Equation",
      "type": "object"
    },
    "EquationStyle": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "default": "typst",
          "enum": [
            "typst",
            "latex"
          ],
          "title": "Engine",
          "type": "string"
        },
        "label_size_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Label Size Px At 1080P",
          "type": "number"
        },
        "latex_packages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Latex Packages",
          "type": "array"
        },
        "math_font": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Math Font"
        },
        "math_font_fallbacks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Math Font Fallbacks",
          "type": "array"
        },
        "size_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Size Px At 1080P",
          "type": "number"
        }
      },
      "required": [
        "size_px_at_1080p",
        "label_size_px_at_1080p"
      ],
      "title": "EquationStyle",
      "type": "object"
    },
    "Geometry": {
      "additionalProperties": false,
      "properties": {
        "annotation_stroke_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Annotation Stroke Px At 1080P",
          "type": "number"
        },
        "axis_stroke_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Axis Stroke Px At 1080P",
          "type": "number"
        },
        "curve_stroke_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Curve Stroke Px At 1080P",
          "type": "number"
        },
        "marker_radius_px_at_1080p": {
          "default": 6.0,
          "exclusiveMinimum": 0,
          "title": "Marker Radius Px At 1080P",
          "type": "number"
        },
        "tick_length_px_at_1080p": {
          "default": 8.0,
          "exclusiveMinimum": 0,
          "title": "Tick Length Px At 1080P",
          "type": "number"
        }
      },
      "required": [
        "axis_stroke_px_at_1080p",
        "curve_stroke_px_at_1080p",
        "annotation_stroke_px_at_1080p"
      ],
      "title": "Geometry",
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "properties": {
        "baseline_grid_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Baseline Grid Px At 1080P",
          "type": "number"
        },
        "panel_gap_px_at_1080p": {
          "minimum": 0,
          "title": "Panel Gap Px At 1080P",
          "type": "number"
        },
        "preferred_alignment": {
          "default": "left",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "title": "Preferred Alignment",
          "type": "string"
        },
        "safe_margin_fraction": {
          "exclusiveMaximum": 0.5,
          "minimum": 0,
          "title": "Safe Margin Fraction",
          "type": "number"
        }
      },
      "required": [
        "safe_margin_fraction",
        "baseline_grid_px_at_1080p",
        "panel_gap_px_at_1080p"
      ],
      "title": "Layout",
      "type": "object"
    },
    "ManimSettings": {
      "additionalProperties": false,
      "description": "The subset of Manim configuration the worker applies. All of it enters the cache key.",
      "properties": {
        "background_color": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Background Color",
          "type": "string"
        },
        "disable_caching": {
          "default": false,
          "title": "Disable Caching",
          "type": "boolean"
        },
        "equation_engine": {
          "default": "typst",
          "enum": [
            "typst",
            "latex"
          ],
          "title": "Equation Engine",
          "type": "string"
        },
        "frame_rate": {
          "exclusiveMinimum": 0,
          "title": "Frame Rate",
          "type": "number"
        },
        "media_dir": {
          "title": "Media Dir",
          "type": "string"
        },
        "pixel_format": {
          "default": "yuv420p",
          "title": "Pixel Format",
          "type": "string"
        },
        "pixel_height": {
          "exclusiveMinimum": 0,
          "title": "Pixel Height",
          "type": "integer"
        },
        "pixel_width": {
          "exclusiveMinimum": 0,
          "title": "Pixel Width",
          "type": "integer"
        },
        "renderer": {
          "default": "cairo",
          "enum": [
            "cairo",
            "opengl"
          ],
          "title": "Renderer",
          "type": "string"
        },
        "save_sections": {
          "default": false,
          "title": "Save Sections",
          "type": "boolean"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        },
        "video_codec": {
          "default": "libx264",
          "title": "Video Codec",
          "type": "string"
        }
      },
      "required": [
        "pixel_width",
        "pixel_height",
        "frame_rate",
        "background_color",
        "media_dir"
      ],
      "title": "ManimSettings",
      "type": "object"
    },
    "Motion": {
      "additionalProperties": false,
      "properties": {
        "avoid_decorative_motion": {
          "default": true,
          "title": "Avoid Decorative Motion",
          "type": "boolean"
        },
        "easing": {
          "default": "smooth",
          "enum": [
            "linear",
            "ease_in_out_sine",
            "smooth",
            "ease_out_cubic"
          ],
          "title": "Easing",
          "type": "string"
        },
        "narration_words_per_minute": {
          "default": 150,
          "exclusiveMinimum": 0,
          "title": "Narration Words Per Minute",
          "type": "number"
        },
        "reveal_seconds": {
          "exclusiveMinimum": 0,
          "title": "Reveal Seconds",
          "type": "number"
        },
        "transition_seconds": {
          "exclusiveMinimum": 0,
          "title": "Transition Seconds",
          "type": "number"
        }
      },
      "required": [
        "transition_seconds",
        "reveal_seconds"
      ],
      "title": "Motion",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "description": "Exact delivery specification. Width:height must agree with `aspect_ratio`.",
      "properties": {
        "aspect_ratio": {
          "pattern": "^\\d+:\\d+$",
          "title": "Aspect Ratio",
          "type": "string"
        },
        "audio": {
          "const": "none",
          "default": "none",
          "title": "Audio",
          "type": "string"
        },
        "container": {
          "default": "mp4",
          "enum": [
            "mp4",
            "mov",
            "webm",
            "gif"
          ],
          "title": "Container",
          "type": "string"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "fps": {
          "exclusiveMinimum": 0,
          "title": "Fps",
          "type": "number"
        },
        "height_px": {
          "exclusiveMinimum": 0,
          "title": "Height Px",
          "type": "integer"
        },
        "video_codec": {
          "default": "h264",
          "enum": [
            "h264",
            "h265",
            "vp9",
            "prores",
            "none"
          ],
          "title": "Video Codec",
          "type": "string"
        },
        "width_px": {
          "exclusiveMinimum": 0,
          "title": "Width Px",
          "type": "integer"
        }
      },
      "required": [
        "duration_seconds",
        "width_px",
        "height_px",
        "aspect_ratio",
        "fps"
      ],
      "title": "OutputSpec",
      "type": "object"
    },
    "ResolvedStyle": {
      "additionalProperties": false,
      "description": "What the renderer receives: all tokens, where each came from, and a content hash.",
      "properties": {
        "hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "layers": {
          "items": {
            "type": "string"
          },
          "title": "Layers",
          "type": "array"
        },
        "provenance": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Provenance",
          "type": "object"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "theme": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Theme",
          "type": "string"
        },
        "theme_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Theme Version",
          "type": "string"
        },
        "tokens": {
          "$ref": "#/$defs/StyleTokens"
        }
      },
      "required": [
        "theme",
        "theme_version",
        "layers",
        "tokens",
        "provenance",
        "hash"
      ],
      "title": "ResolvedStyle",
      "type": "object"
    },
    "SceneTarget": {
      "additionalProperties": false,
      "description": "A storyboard scene's interval, so a video job can verify its section against the storyboard.",
      "properties": {
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "scene_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Scene Id",
          "type": "string"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        }
      },
      "required": [
        "scene_id",
        "start_seconds",
        "end_seconds"
      ],
      "title": "SceneTarget",
      "type": "object"
    },
    "SnapshotTarget": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "expected_time_seconds": {
          "minimum": 0,
          "title": "Expected Time Seconds",
          "type": "number"
        },
        "scene_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Scene Id",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "expected_time_seconds",
        "description"
      ],
      "title": "SnapshotTarget",
      "type": "object"
    },
    "StyleTokens": {
      "additionalProperties": false,
      "description": "Fully resolved tokens. Every section is required; unknown keys are errors.",
      "properties": {
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "charts": {
          "$ref": "#/$defs/Charts"
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "layout": {
          "$ref": "#/$defs/Layout"
        },
        "motion": {
          "$ref": "#/$defs/Motion"
        },
        "palette": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            }
          },
          "title": "Palette",
          "type": "object"
        },
        "typography": {
          "$ref": "#/$defs/Typography"
        }
      },
      "required": [
        "palette",
        "typography",
        "layout",
        "geometry",
        "charts",
        "motion",
        "accessibility"
      ],
      "title": "StyleTokens",
      "type": "object"
    },
    "SymbolDef": {
      "additionalProperties": false,
      "properties": {
        "meaning": {
          "minLength": 1,
          "title": "Meaning",
          "type": "string"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "meaning"
      ],
      "title": "SymbolDef",
      "type": "object"
    },
    "Typeface": {
      "additionalProperties": false,
      "properties": {
        "font_fallbacks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Font Fallbacks",
          "type": "array"
        },
        "font_family": {
          "minLength": 1,
          "title": "Font Family",
          "type": "string"
        },
        "size_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Size Px At 1080P",
          "type": "number"
        },
        "weight": {
          "default": "regular",
          "enum": [
            "light",
            "regular",
            "medium",
            "semibold",
            "bold"
          ],
          "title": "Weight",
          "type": "string"
        }
      },
      "required": [
        "font_family",
        "size_px_at_1080p"
      ],
      "title": "Typeface",
      "type": "object"
    },
    "Typography": {
      "additionalProperties": false,
      "properties": {
        "annotation": {
          "$ref": "#/$defs/Typeface"
        },
        "axis_label": {
          "$ref": "#/$defs/Typeface"
        },
        "body": {
          "$ref": "#/$defs/Typeface"
        },
        "caption": {
          "$ref": "#/$defs/Typeface"
        },
        "equation": {
          "$ref": "#/$defs/EquationStyle"
        },
        "minimum_text_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Minimum Text Px At 1080P",
          "type": "number"
        },
        "tick_label": {
          "$ref": "#/$defs/Typeface"
        },
        "title": {
          "$ref": "#/$defs/Typeface"
        }
      },
      "required": [
        "title",
        "body",
        "annotation",
        "axis_label",
        "tick_label",
        "caption",
        "equation",
        "minimum_text_px_at_1080p"
      ],
      "title": "Typography",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cache_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Cache Key",
      "type": "string"
    },
    "data_files": {
      "default": {},
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "type": "string"
        }
      },
      "title": "Data Files",
      "type": "object"
    },
    "equations": {
      "default": {},
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "$ref": "#/$defs/Equation"
        }
      },
      "title": "Equations",
      "type": "object"
    },
    "family_id": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Family Id",
      "type": "string"
    },
    "job_id": {
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "manim": {
      "$ref": "#/$defs/ManimSettings"
    },
    "operation": {
      "enum": [
        "render_snapshots",
        "render_video",
        "probe"
      ],
      "title": "Operation",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/OutputSpec"
    },
    "output_dir": {
      "title": "Output Dir",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "quality_profile": {
      "enum": [
        "storyboard",
        "snapshot",
        "draft",
        "final"
      ],
      "title": "Quality Profile",
      "type": "string"
    },
    "resolved_style": {
      "$ref": "#/$defs/ResolvedStyle"
    },
    "revision_id": {
      "minLength": 1,
      "title": "Revision Id",
      "type": "string"
    },
    "samples": {
      "default": {},
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "type": "number"
        }
      },
      "title": "Samples",
      "type": "object"
    },
    "scene_class": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "title": "Scene Class",
      "type": "string"
    },
    "scene_module": {
      "title": "Scene Module",
      "type": "string"
    },
    "scenes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SceneTarget"
      },
      "title": "Scenes",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "title": "Snapshot Ids",
      "type": "array"
    },
    "snapshots": {
      "default": {},
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "$ref": "#/$defs/SnapshotTarget"
        }
      },
      "title": "Snapshots",
      "type": "object"
    }
  },
  "required": [
    "job_id",
    "project_id",
    "revision_id",
    "family_id",
    "operation",
    "quality_profile",
    "scene_module",
    "scene_class",
    "output",
    "resolved_style",
    "manim",
    "output_dir",
    "cache_key"
  ],
  "title": "RenderJob",
  "type": "object"
}
