{
  "$defs": {
    "GroupStyle": {
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "additionalProperties": true,
          "default": {},
          "title": "Overrides",
          "type": "object"
        }
      },
      "title": "GroupStyle",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shared_assets": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Shared Assets",
      "type": "array"
    },
    "style": {
      "$ref": "#/$defs/GroupStyle",
      "default": {
        "overrides": {}
      }
    },
    "tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "title": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    }
  },
  "required": [
    "schema_version",
    "id"
  ],
  "title": "GroupManifest",
  "type": "object"
}
