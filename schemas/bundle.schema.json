{
  "$defs": {
    "BundleEnvironment": {
      "additionalProperties": false,
      "properties": {
        "lockfile": {
          "default": false,
          "title": "Lockfile",
          "type": "boolean"
        },
        "manager": {
          "default": "uv",
          "title": "Manager",
          "type": "string"
        },
        "packages_relative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packages Relative"
        },
        "pyproject": {
          "default": false,
          "title": "Pyproject",
          "type": "boolean"
        },
        "system_requirements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SystemRequirement"
          },
          "title": "System Requirements",
          "type": "array"
        }
      },
      "title": "BundleEnvironment",
      "type": "object"
    },
    "BundleProject": {
      "additionalProperties": false,
      "properties": {
        "applied_proposals": {
          "default": 0,
          "title": "Applied Proposals",
          "type": "integer"
        },
        "feedback_records": {
          "default": 0,
          "title": "Feedback Records",
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "renders_included": {
          "default": false,
          "title": "Renders Included",
          "type": "boolean"
        },
        "revisions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Revisions",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "title"
      ],
      "title": "BundleProject",
      "type": "object"
    },
    "EnvironmentSpec": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "install_policy": {
          "const": "explicit",
          "default": "explicit",
          "title": "Install Policy",
          "type": "string"
        },
        "lockfile": {
          "default": "uv.lock",
          "title": "Lockfile",
          "type": "string"
        },
        "manager": {
          "default": "uv",
          "enum": [
            "uv",
            "docker",
            "apptainer"
          ],
          "title": "Manager",
          "type": "string"
        },
        "project_root": {
          "default": ".",
          "title": "Project Root",
          "type": "string"
        }
      },
      "title": "EnvironmentSpec",
      "type": "object"
    },
    "FamilyManifest": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "default": [],
          "items": {
            "enum": [
              "text_caption",
              "scientific_plot",
              "function_plot",
              "surface_plot",
              "function_image",
              "equation_block",
              "equation_label",
              "comparison_plot",
              "caption_with_citation",
              "schematic_population",
              "receptive_field_glyph",
              "network_graph",
              "custom"
            ],
            "type": "string"
          },
          "title": "Components",
          "type": "array"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentSpec",
          "default": {
            "image": null,
            "install_policy": "explicit",
            "lockfile": "uv.lock",
            "manager": "uv",
            "project_root": "."
          }
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "schema_extensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Schema Extensions",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "shared_assets": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Shared Assets",
          "type": "array"
        },
        "style": {
          "$ref": "#/$defs/FamilyStyle"
        },
        "system_requirements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SystemRequirement"
          },
          "title": "System Requirements",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "style"
      ],
      "title": "FamilyManifest",
      "type": "object"
    },
    "FamilyStyle": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "overrides": {
          "additionalProperties": true,
          "default": {},
          "title": "Overrides",
          "type": "object"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "FamilyStyle",
      "type": "object"
    },
    "InclusionPolicy": {
      "additionalProperties": false,
      "properties": {
        "include_renders": {
          "default": false,
          "title": "Include Renders",
          "type": "boolean"
        },
        "include_source_assets": {
          "default": false,
          "title": "Include Source Assets",
          "type": "boolean"
        },
        "redact_paths": {
          "default": false,
          "title": "Redact Paths",
          "type": "boolean"
        }
      },
      "title": "InclusionPolicy",
      "type": "object"
    },
    "OmittedSource": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "relink": {
          "title": "Relink",
          "type": "string"
        },
        "role": {
          "enum": [
            "illustrative_data",
            "empirical_data",
            "composition_reference",
            "style_reference",
            "scientific_reference",
            "target_keyframe",
            "explanatory_text"
          ],
          "title": "Role",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Source Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "csv",
            "pdf",
            "image",
            "markdown",
            "text",
            "project"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "source_id",
        "type",
        "role",
        "path",
        "reason",
        "relink"
      ],
      "title": "OmittedSource",
      "type": "object"
    },
    "SystemRequirement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "binary",
            "library",
            "font",
            "image",
            "python_module"
          ],
          "title": "Kind",
          "type": "string"
        },
        "min_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Version"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "SystemRequirement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assets": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Assets",
      "type": "array"
    },
    "bundle_id": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "checksum_file": {
      "default": "MANIFEST.sha256",
      "title": "Checksum File",
      "type": "string"
    },
    "components": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Components",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/BundleEnvironment",
      "default": {
        "lockfile": false,
        "manager": "uv",
        "packages_relative": null,
        "pyproject": false,
        "system_requirements": []
      }
    },
    "family": {
      "$ref": "#/$defs/FamilyManifest"
    },
    "file_count": {
      "default": 0,
      "minimum": 0,
      "title": "File Count",
      "type": "integer"
    },
    "kind": {
      "enum": [
        "project",
        "family"
      ],
      "title": "Kind",
      "type": "string"
    },
    "notes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "omitted_sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OmittedSource"
      },
      "title": "Omitted Sources",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/InclusionPolicy",
      "default": {
        "include_renders": false,
        "include_source_assets": false,
        "redact_paths": false
      }
    },
    "projects": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BundleProject"
      },
      "title": "Projects",
      "type": "array"
    },
    "registry_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Registry Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scianim_version": {
      "title": "Scianim Version",
      "type": "string"
    },
    "styles": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Styles",
      "type": "array"
    }
  },
  "required": [
    "bundle_id",
    "kind",
    "created_at",
    "scianim_version",
    "registry_version",
    "family"
  ],
  "title": "BundleManifest",
  "type": "object"
}
