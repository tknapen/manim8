{
  "$defs": {
    "PartialAccessibility": {
      "additionalProperties": false,
      "properties": {
        "do_not_rely_on_color_alone": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Do Not Rely On Color Alone"
        },
        "minimum_contrast_body": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Contrast Body"
        },
        "warn_on_low_contrast": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warn On Low Contrast"
        }
      },
      "title": "PartialAccessibility",
      "type": "object"
    },
    "PartialCharts": {
      "additionalProperties": false,
      "properties": {
        "grid_visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grid Visible"
        },
        "legend_position": {
          "anyOf": [
            {
              "enum": [
                "upper_right",
                "upper_left",
                "lower_right",
                "lower_left"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legend Position"
        },
        "show_units_when_provided": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Show Units When Provided"
        },
        "spine_offset_px_at_1080p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spine Offset Px At 1080P"
        },
        "spines": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "left",
                  "bottom",
                  "top",
                  "right"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spines"
        },
        "use_shared_scales_for_comparison": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Use Shared Scales For Comparison"
        }
      },
      "title": "PartialCharts",
      "type": "object"
    },
    "PartialEquationStyle": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "anyOf": [
            {
              "enum": [
                "typst",
                "latex"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "label_size_px_at_1080p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label Size Px At 1080P"
        },
        "latex_packages": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latex Packages"
        },
        "math_font": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Math Font"
        },
        "math_font_fallbacks": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Math Font Fallbacks"
        },
        "size_px_at_1080p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Px At 1080P"
        }
      },
      "title": "PartialEquationStyle",
      "type": "object"
    },
    "PartialGeometry": {
      "additionalProperties": false,
      "properties": {
        "annotation_stroke_px_at_1080p": {
