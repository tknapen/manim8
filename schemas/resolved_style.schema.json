{
  "$defs": {
    "Accessibility": {
      "additionalProperties": false,
      "properties": {
        "do_not_rely_on_color_alone": {
          "default": true,
          "title": "Do Not Rely On Color Alone",
          "type": "boolean"
        },
        "minimum_contrast_body": {
          "default": 4.5,
          "exclusiveMinimum": 0,
          "title": "Minimum Contrast Body",
          "type": "number"
        },
        "warn_on_low_contrast": {
          "default": true,
          "title": "Warn On Low Contrast",
          "type": "boolean"
        }
      },
      "title": "Accessibility",
      "type": "object"
    },
    "Charts": {
      "additionalProperties": false,
      "properties": {
        "grid_visible": {
          "default": false,
          "title": "Grid Visible",
          "type": "boolean"
        },
        "legend_position": {
          "default": "upper_right",
          "enum": [
            "upper_right",
            "upper_left",
            "lower_right",
            "lower_left"
          ],
          "title": "Legend Position",
          "type": "string"
        },
        "show_units_when_provided": {
          "default": true,
          "title": "Show Units When Provided",
          "type": "boolean"
        },
        "spine_offset_px_at_1080p": {
          "default": 0.0,
          "minimum": 0,
          "title": "Spine Offset Px At 1080P",
          "type": "number"
        },
        "spines": {
          "default": [
            "left",
            "bottom"
          ],
          "items": {
            "enum": [
              "left",
              "bottom",
              "top",
              "right"
            ],
            "type": "string"
          },
          "title": "Spines",
          "type": "array"
        },
        "use_shared_scales_for_comparison": {
          "default": true,
          "title": "Use Shared Scales For Comparison",
          "type": "boolean"
        }
      },
      "title": "Charts",
      "type": "object"
    },
    "EquationStyle": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "default": "typst",
          "enum": [
            "typst",
            "latex"
          ],
          "title": "Engine",
          "type": "string"
        },
        "label_size_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Label Size Px At 1080P",
          "type": "number"
        },
        "latex_packages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Latex Packages",
          "type": "array"
        },
        "math_font": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Math Font"
        },
        "math_font_fallbacks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Math Font Fallbacks",
          "type": "array"
        },
        "size_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Size Px At 1080P",
          "type": "number"
        }
      },
      "required": [
        "size_px_at_1080p",
        "label_size_px_at_1080p"
      ],
      "title": "EquationStyle",
      "type": "object"
    },
    "Geometry": {
      "additionalProperties": false,
      "properties": {
        "annotation_stroke_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Annotation Stroke Px At 1080P",
          "type": "number"
        },
        "axis_stroke_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Axis Stroke Px At 1080P",
          "type": "number"
        },
        "curve_stroke_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Curve Stroke Px At 1080P",
          "type": "number"
        },
        "line_cap": {
          "default": "butt",
          "enum": [
            "butt",
            "round"
          ],
          "title": "Line Cap",
          "type": "string"
        },
        "marker_radius_px_at_1080p": {
          "default": 6.0,
          "exclusiveMinimum": 0,
          "title": "Marker Radius Px At 1080P",
          "type": "number"
        },
        "marker_rim_px_at_1080p": {
          "default": 0.0,
          "minimum": 0,
          "title": "Marker Rim Px At 1080P",
          "type": "number"
        },
        "tick_length_px_at_1080p": {
          "default": 8.0,
          "exclusiveMinimum": 0,
          "title": "Tick Length Px At 1080P",
          "type": "number"
        }
      },
      "required": [
        "axis_stroke_px_at_1080p",
        "curve_stroke_px_at_1080p",
        "annotation_stroke_px_at_1080p"
      ],
      "title": "Geometry",
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "properties": {
        "baseline_grid_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Baseline Grid Px At 1080P",
          "type": "number"
        },
        "panel_gap_px_at_1080p": {
          "minimum": 0,
          "title": "Panel Gap Px At 1080P",
          "type": "number"
        },
        "preferred_alignment": {
          "default": "left",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "title": "Preferred Alignment",
          "type": "string"
        },
        "safe_margin_fraction": {
          "exclusiveMaximum": 0.5,
          "minimum": 0,
          "title": "Safe Margin Fraction",
          "type": "number"
        }
      },
      "required": [
        "safe_margin_fraction",
        "baseline_grid_px_at_1080p",
        "panel_gap_px_at_1080p"
      ],
      "title": "Layout",
      "type": "object"
    },
    "Motion": {
      "additionalProperties": false,
      "properties": {
        "avoid_decorative_motion": {
          "default": true,
          "title": "Avoid Decorative Motion",
          "type": "boolean"
        },
        "camera_easing": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "ease_in_out_sine",
                "smooth",
                "ease_out_cubic",
                "eased_linear"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Easing"
        },
        "easing": {
          "default": "smooth",
          "enum": [
            "linear",
            "ease_in_out_sine",
            "smooth",
            "ease_out_cubic",
            "eased_linear"
          ],
          "title": "Easing",
          "type": "string"
        },
        "emphasis_scale": {
          "default": 1.3,
          "exclusiveMinimum": 1,
          "maximum": 2,
          "title": "Emphasis Scale",
          "type": "number"
        },
        "emphasis_seconds": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "title": "Emphasis Seconds",
          "type": "number"
        },
        "hold_seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Hold Seconds",
          "type": "number"
        },
        "narration_words_per_minute": {
          "default": 150,
          "exclusiveMinimum": 0,
          "title": "Narration Words Per Minute",
          "type": "number"
        },
        "ramp_seconds": {
          "default": 1.5,
          "exclusiveMinimum": 0,
          "title": "Ramp Seconds",
          "type": "number"
        },
        "reveal_seconds": {
          "exclusiveMinimum": 0,
          "title": "Reveal Seconds",
          "type": "number"
        },
        "transition_seconds": {
          "exclusiveMinimum": 0,
          "title": "Transition Seconds",
          "type": "number"
        }
      },
      "required": [
        "transition_seconds",
        "reveal_seconds"
      ],
      "title": "Motion",
      "type": "object"
    },
    "StyleTokens": {
      "additionalProperties": false,
      "description": "Fully resolved tokens. Every section is required; unknown keys are errors.",
      "properties": {
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "charts": {
          "$ref": "#/$defs/Charts"
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "layout": {
          "$ref": "#/$defs/Layout"
        },
        "motion": {
          "$ref": "#/$defs/Motion"
        },
        "palette": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            }
          },
          "title": "Palette",
          "type": "object"
        },
        "three_d": {
          "$ref": "#/$defs/ThreeD",
          "default": {
            "camera_phi_degrees": 62.0,
            "camera_theta_degrees": -50.0,
            "light_azimuth_degrees": -135.0,
            "light_elevation_degrees": 50.0,
            "mesh_role": "secondary_text",
            "mesh_stroke_px_at_1080p": 0.8,
            "shading_strength": 0.0,
            "surface_opacity": 0.5
          }
        },
        "typography": {
          "$ref": "#/$defs/Typography"
        }
      },
      "required": [
        "palette",
        "typography",
        "layout",
        "geometry",
        "charts",
        "motion",
        "accessibility"
      ],
      "title": "StyleTokens",
      "type": "object"
    },
    "ThreeD": {
      "additionalProperties": false,
      "description": "Surfaces and the orbiting camera. Flat objects stay fixed in the frame; only 3D kinds turn.",
      "properties": {
        "camera_phi_degrees": {
          "default": 62,
          "maximum": 90,
          "minimum": 0,
          "title": "Camera Phi Degrees",
          "type": "number"
        },
        "camera_theta_degrees": {
          "default": -50,
          "title": "Camera Theta Degrees",
          "type": "number"
        },
        "light_azimuth_degrees": {
          "default": -135,
          "title": "Light Azimuth Degrees",
          "type": "number"
        },
        "light_elevation_degrees": {
          "default": 50,
          "maximum": 90,
          "minimum": 0,
          "title": "Light Elevation Degrees",
          "type": "number"
        },
        "mesh_role": {
          "default": "secondary_text",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Mesh Role",
          "type": "string"
        },
        "mesh_stroke_px_at_1080p": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "title": "Mesh Stroke Px At 1080P",
          "type": "number"
        },
        "shading_strength": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Shading Strength",
          "type": "number"
        },
        "surface_opacity": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Surface Opacity",
          "type": "number"
        }
      },
      "title": "ThreeD",
      "type": "object"
    },
    "Typeface": {
      "additionalProperties": false,
      "properties": {
        "font_fallbacks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Font Fallbacks",
          "type": "array"
        },
        "font_family": {
          "minLength": 1,
          "title": "Font Family",
          "type": "string"
        },
        "size_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Size Px At 1080P",
          "type": "number"
        },
        "weight": {
          "default": "regular",
          "enum": [
            "light",
            "regular",
            "medium",
            "semibold",
            "bold"
          ],
          "title": "Weight",
          "type": "string"
        }
      },
      "required": [
        "font_family",
        "size_px_at_1080p"
      ],
      "title": "Typeface",
      "type": "object"
    },
    "Typography": {
      "additionalProperties": false,
      "properties": {
        "annotation": {
          "$ref": "#/$defs/Typeface"
        },
        "axis_label": {
          "$ref": "#/$defs/Typeface"
        },
        "body": {
          "$ref": "#/$defs/Typeface"
        },
        "caption": {
          "$ref": "#/$defs/Typeface"
        },
        "equation": {
          "$ref": "#/$defs/EquationStyle"
        },
        "minimum_text_px_at_1080p": {
          "exclusiveMinimum": 0,
          "title": "Minimum Text Px At 1080P",
          "type": "number"
        },
        "tick_label": {
          "$ref": "#/$defs/Typeface"
        },
        "title": {
          "$ref": "#/$defs/Typeface"
        }
      },
      "required": [
        "title",
        "body",
        "annotation",
        "axis_label",
        "tick_label",
        "caption",
        "equation",
        "minimum_text_px_at_1080p"
      ],
      "title": "Typography",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the renderer receives: all tokens, where each came from, and a content hash.",
  "properties": {
    "hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Hash",
      "type": "string"
    },
    "layers": {
      "items": {
        "type": "string"
      },
      "title": "Layers",
      "type": "array"
    },
    "provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Provenance",
      "type": "object"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "theme": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Theme",
      "type": "string"
    },
    "theme_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Theme Version",
      "type": "string"
    },
    "tokens": {
      "$ref": "#/$defs/StyleTokens"
    }
  },
  "required": [
    "theme",
    "theme_version",
    "layers",
    "tokens",
    "provenance",
    "hash"
  ],
  "title": "ResolvedStyle",
  "type": "object"
}
